# ---------------------------------------------------------------------------
# Malaga Prospect Finder — environment template
# Copy to `.env` and fill in. NEVER commit the filled-in `.env`.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
DATABASE_URL=postgres://prospect:prospect@localhost:5544/prospect_finder
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000
# The test suite creates and migrates its own database. Leave unset to use the
# local Docker instance; set it to run the tests against any other server.
TEST_DATABASE_URL=

# --- Scheduled refresh (hosted deployments) --------------------------------
# Authenticates GET /api/cron/refresh. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Sites audited more recently than this are left alone by the scheduled run.
REFRESH_STALE_AFTER_DAYS=14

# --- API auth (required in production) -------------------------------------
# Comma-separated bearer tokens accepted by mutating/admin API routes.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKENS=
# When true, read-only endpoints (search, top, dashboard) require a token too.
REQUIRE_AUTH_FOR_READS=false
# Writes are accepted from the app's own UI (same-origin) without a token so the
# action buttons work locally. Set true to require a token even from the UI.
REQUIRE_TOKEN_FOR_UI_WRITES=false

# --- Geographic scope (Malaga-only by default) -----------------------------
GEO_SCOPE_CITY=Malaga
GEO_SCOPE_PROVINCE=Malaga
GEO_SCOPE_COUNTRY=ES
# Minimum location confidence (0..1) a business needs to be searchable.
GEO_MIN_LOCATION_CONFIDENCE=0.7

# --- Search behaviour ------------------------------------------------------
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=25
# Quality gate: prospects below this opportunity score are never returned.
SEARCH_MIN_OPPORTUNITY_SCORE=45
SEARCH_MIN_EVIDENCE_SCORE=0.35

# --- Scoring weights (must sum to 1.0) -------------------------------------
WEIGHT_BUSINESS_QUALITY=0.35
WEIGHT_COMMERCIAL_VALUE=0.25
WEIGHT_DIGITAL_OPPORTUNITY=0.40

# --- Website audit ---------------------------------------------------------
AUDIT_USER_AGENT=MalagaProspectFinder/1.0 (+https://example.com/bot; contact=you@example.com)
AUDIT_MAX_PAGES=8
AUDIT_TIMEOUT_MS=12000
AUDIT_CONCURRENCY=4
# Playwright is only used when a page genuinely needs JS rendering.
AUDIT_ENABLE_PLAYWRIGHT=false

# --- Data sources ----------------------------------------------------------
# OpenStreetMap Overpass API (public, no key). Respect its usage policy.
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# Overpass rejects descriptive parenthesised agent strings; keep this plain.
OVERPASS_USER_AGENT=MalagaProspectFinder/1.0
OVERPASS_TIMEOUT_MS=90000
# Official Google Places API key (optional). Supplies public rating/review counts.
GOOGLE_PLACES_API_KEY=

# --- AI providers (optional; the app runs fully without them) --------------
# Calls route through Vercel AI Gateway when a credential is present, which
# gives failover across providers and one place to see spend. Without it the
# app falls back to the direct Groq call, and below that to deterministic
# templates -- so none of this is required.
# Create a key at https://vercel.com/[team]/~/ai/api-keys
AI_GATEWAY_API_KEY=
# Override the model per task. Free-tier gateway credits only serve the
# gpt-oss models; buying credits unlocks the rest without a redeploy, e.g.
#   AI_MODEL_WRITE=anthropic/claude-sonnet-4.6
AI_MODEL_CLASSIFY=
AI_MODEL_ANALYSE=
AI_MODEL_WRITE=

GROQ_API_KEY=
# Must support response_format=json_object. Groq retired the Llama models.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_CANDIDATES=100

ANTHROPIC_API_KEY=
# Optional. Without a key the deep pass runs on the free model instead.
ANTHROPIC_MODEL=claude-opus-5
CLAUDE_MAX_CANDIDATES=30

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_READS=120
RATE_LIMIT_MAX_WRITES=20
